{
  "manifest_version": 3,
  "name": "Monitor Switcher",
  "version": "1.0.0",
  "description": "Move your browser window between monitors and automatically maximize it with one click. No keyboard shortcuts or dragging required.",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    }

  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },

  "permissions": ["system.display"]

}